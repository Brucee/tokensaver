{
  "mcpServers": {
    "code": {
      "command": "node",
      "args": [
        "--no-warnings=ExperimentalWarning",
        "-e",
        "var a=process.argv[1]||'';require(((a.indexOf('${')<0&&a)||process.cwd())+'/scripts/ensure-deps.cjs')",
        "${CLAUDE_PLUGIN_ROOT}"
      ],
      "cwd": ".",
      "alwaysLoad": true,
      "env": {
        "TOKENSAVER_MCP_CWD_HOOK_INJECTED": "1",
        "TOKENSAVER_BUNDLE_VERSION": "1.0.8"
      }
    }
  }
}
